{
  "name": "rn-iso-monorepo",
  "private": true,
  "description": "Workspace root. The published packages live in packages/.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/rn-iso/tsconfig.json && tsc --noEmit -p packages/metro/tsconfig.json && tsc --noEmit -p packages/expo-build-cache/tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "node --test test/e2e/*.e2e.js"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  }
}
