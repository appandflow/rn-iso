{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "node": true,
    "es2023": true
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**"],
  "rules": {
    "no-unused-vars": "warn",
    "typescript/no-explicit-any": "error"
  }
}
